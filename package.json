    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "generate:social": "node scripts/generate-social.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "build": "node scripts/generate-social.mjs && node ./node_modules/astro/bin/astro.mjs build",
    "preview": "node ./node_modules/astro/bin/astro.mjs preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
