{
  "name": "almonaci-miraglia",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/astro/bin/astro.mjs dev",
