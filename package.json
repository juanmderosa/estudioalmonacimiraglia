    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "axe-core": "^4.14.0",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  }
