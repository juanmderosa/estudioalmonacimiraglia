---
import "../styles/global.css";
import Head from "../components/Head.astro";
import { business } from "../data/business";
interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang={business.language}>
  <Head
    title={title}
    description={description}
  />
  <body id="inicio">
    <slot />
  </body>
</html>
