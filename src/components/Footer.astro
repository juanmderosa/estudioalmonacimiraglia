---
import Arrow from "./Arrow.astro";
import Brand from "./Brand.astro";
import { business } from "../data/business";
---

<footer class="site-footer">
  <div class="shell footer-content">
    <Brand
      name={business.name}
      category={business.category}
    />

    <p>Defensa comprometida.<br />Atención cercana.</p>
    <a
      class="footer-contact"
      href="#contacto"
      >Hablemos <Arrow />
    </a>
  </div>
  <div class="shell footer-bottom">
    <small>© {new Date().getFullYear()} {business.name}</small>
    <small class="footer-credit">
      <span>Desarrollado por:</span>
      <a href="https://juanmderosa-developer.com">JuanmderosaDeveloper</a>
    </small>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-brand);
    color: #fff;
    padding-block: 42px 24px;
  }
  .footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding-bottom: 35px;
  }
  .footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 25px;
    min-height: 44px;
  }
  .footer-bottom {
    border-top: 1px solid #ffffff80;
    padding-top: 20px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 20px;
    font-size: 14px;
  }
  .footer-bottom small {
    font-size: 14px;
  }
  .footer-bottom a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .footer-credit {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 6px;
  }
  .footer-credit a {
    font-weight: 500;
    text-decoration-thickness: 1px;
    overflow-wrap: anywhere;
  }
  .footer-credit a:hover {
    text-decoration-thickness: 2px;
  }
  .site-footer :focus-visible {
    outline-color: #fff;
  }
  @media (max-width: 47.99rem) {
    .footer-content,
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 22px;
    }
  }
  .site-footer {
    --focus: #fff;
  }
</style>
